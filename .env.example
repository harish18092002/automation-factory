# ── Slack Bot ────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# ── Mode ──────────────────────────────────────────────────────────────────────
# IS_PERSONAL=yes  → use Groq / DeepSeek / Gemini API keys (personal/dev setup)
# IS_PERSONAL=no   → use Claude CLI only (team setup, no API keys required)
IS_PERSONAL=yes

# ── AI Providers (only used when IS_PERSONAL=yes) ─────────────────────────────

# T1: DeepSeek V3.2 — Primary workhorse ($0.28/$0.42 per M tokens, best cost/quality)
# Get key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-key

# T2: Gemini 2.5 Flash — Long-context tasks (1M tokens, free tier available)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza-your-gemini-key

# T3: Groq — Fast cheap routing (classification, summarisation, ~1000 tok/sec)
# Get key: https://console.groq.com/ (free tier: 14,400 req/day)
GROQ_API_KEY=gsk_your-groq-key

# T4: Claude Code CLI — Fallback using your Claude subscription (no API key needed)
# Uses `claude` CLI subprocess. Requires Claude Code installed.

# ── Web Search (optional — enables web_search tool) ──────────────────────────
# Option A: Tavily (recommended for agents) — https://app.tavily.com/
TAVILY_API_KEY=tvly-your-tavily-key

# Option B: Brave Search — https://api.search.brave.com/
# BRAVE_API_KEY=BSA-your-brave-key
